# ==============================================================================
# Project Parewa — Auth Service Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ---- Redis -------------------------------------------------------------------
REDIS_URL=redis://parewa-redis:6379

# ---- SMTP (Email OTP Delivery) ----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@parewa.local

# ---- Server ------------------------------------------------------------------
PORT=8080
NODE_ENV=production
